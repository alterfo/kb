# Root directory for ingested markdown documents (Connector/Sink output).
KB_ROOT=./kb_root

# Directory for the SQLite persistence file (kb.db), sync state, tombstones.
PERSIST_DIR=./kb_root/.persist

# Base URL of an OpenAI-compatible endpoint for the CHAT/COMPLETIONS model
# (entity/relation extraction, answer synthesis, rerank). The chat completions
# path is /v1/chat/completions. Point this at a remote GPU host, NOT the local
# machine. Must bypass the proxy for the host listed in KB_NO_PROXY below.
KB_LLM_BASE_URL=http://<remote-host>:11434

# Query-time embeddings (retrieval) hit the LOCAL endpoint by default
# (http://127.0.0.1:11434) and serve live query vectors. Override only to change
# the local embed endpoint. Embeddings use the /v1/embeddings path.
# KB_EMBED_BASE_URL=http://127.0.0.1:11434

# Bulk indexing embeddings follow the chat box by default (KB_EMBED_INDEX_BASE_URL
# defaults to KB_LLM_BASE_URL = remote host), so heavy one-time reindex work runs on
# the remote GPU. Set explicitly if the index box differs.
# KB_EMBED_INDEX_BASE_URL=http://<remote-host>:11434

# Chat/completions model name.
KB_LLM_MODEL=qwen3.8:latest

# Embeddings model name. Must be an embeddings-capable model (e.g. qwen3-embedding).
KB_EMBED_MODEL=qwen3-embedding

# Model used by `kb describe` to generate document summaries (default qwen3.8:latest).
# KB_DESCRIBE_MODEL=qwen3.8:latest
# Batch size for `kb describe` summary generation.
# KB_DESCRIBE_BATCH=10

# Enable hybrid retrieval (dense + BM25 + RRF). Set to "false" for dense-only.
KB_HYBRID=true

# Reranker: off | llm | onnx
KB_RERANK=off

# Authority prior bonuses for retrieval ranking, as "prefix=bonus,prefix=bonus".
KB_AUTHORITY_BONUS=notes/=0.15,notes/approved/=0.30

# Comma-separated hosts that must bypass any HTTP(S)_PROXY env vars (direct connection).
KB_NO_PROXY=127.0.0.1

# Default top-K results returned by retrieval.
KB_TOP_K=10

# Chunking parameters (token counts).
KB_CHUNK_SIZE=4096
KB_CHUNK_OVERLAP=512

# Reciprocal Rank Fusion constant.
KB_RRF_K=60

# Sync staleness threshold for doctor / /integrations.
KB_STALE_AFTER=24h

# Community detection algorithm: louvain (default, flat) or leiden
# (hierarchical, requires the audited go-leiden dependency).
KB_COMMUNITY_ALGO=louvain

# Rolling memory window for the ask flow: the last N resolved sub-answers
# (plus pinned dependency answers) fed into synthesis to bound context.
KB_ASK_ROLLING_WINDOW=3

# LLM request timeout (embed + chat). Raise this if your endpoint cold-loads
# models on demand (large reindex runs need headroom for that first request).
KB_LLM_TIMEOUT=60s

# GoT budget: max subgoals per question and max gap-refine queries per run.
# Lower values cut per-question LLM calls at some recall cost (bench speed).
# KB_MAX_SUBGOALS=5
# KB_MAX_GAP_QUERIES=3

# --- Connector secrets (names only go in sources.yaml; values live here) ---
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# CONFLUENCE_EMAIL=
# CONFLUENCE_TOKEN=
# SLACK_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# MATTERMOST_TOKEN=
# YANDEX_TRACKER_OAUTH_TOKEN=
# YANDEX_TRACKER_ORG_ID=
# YOUTRACK_TOKEN=
# KAITEN_TOKEN=
# WEEEK_TOKEN=
# KB_DISCORD_TOKEN=
# TRELLO_KEY=
# TRELLO_TOKEN=

# Optional SOCKS5 proxy (socks5://host:port) used by the discord connector.
# KB_SOCKS_PROXY=socks5://127.0.0.1:3333
